# CivicNexus Platform Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
DATABASE_URL=sqlite:///./impactbridge.db

# =========================================================================
# FIREBASE API & CLOUD FIRESTORE CONFIGURATION
# =========================================================================
# 1. Firebase Web Client API Key (from Firebase Console -> Project Settings -> General -> Web App):
FIREBASE_API_KEY=AIzaSyCivicNexusDemoKeyForFirebaseWeb

# 2. Firebase Project ID:
FIREBASE_PROJECT_ID=impactbridge-app

# 3. Firebase Auth Domain:
FIREBASE_AUTH_DOMAIN=impactbridge-app.firebaseapp.com

# 4. Firebase Cloud Storage Bucket:
FIREBASE_STORAGE_BUCKET=impactbridge-app.appspot.com

# 5. Firebase Messaging Sender ID & Web App ID:
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 6. Service Account JSON file path (for Firebase Admin SDK backend privileges):
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# 7. Auto-replicate every new challenge/user directly to Cloud Firestore:
FIREBASE_SYNC_ON_WRITE=True
